@inproceedings{ying2026exemplar2vqa,
  abbr = {NeurIPS},
  title = {{Exemplar2VQA}: A Scalable Exemplar-Driven Visual Question Answering Generation Framework via Multi-Agent Coding},
  author = {Ying, Jiayu and Tian, Qijian and Xu, Ruijie and Zhu, Xinnan and Dong, Daoguo and Xu, Jiachen and Tan, Xin},
  abstract = {Advancing spatial intelligence in Multimodal Large Language Models (MLLMs) is bottlenecked by the scarcity of complex, scalable 3D question-answer (QA) data. While manual annotation is labor-intensive, directly utilizing LLMs to synthesize these QA pairs often fails due to their inherent deficiencies in spatial and geometric computation. We introduce Exemplar2VQA, a scalable exemplar-driven visual question answering generation framework that rapidly synthesizes large-scale spatial QA pairs in simulated environments via multi-agent coding. By equipping collaborative agents with a meticulously designed library of geometric utilities, Exemplar2VQA bypasses LLMs' spatial reasoning flaws through deterministic code execution. Crucially, the framework exhibits remarkable versatility: taking diverse static object-centric spatial query templates as exemplars, it seamlessly and autonomously scales them into massive, high-fidelity synthetic datasets. Fine-tuning Qwen2.5-VL (3B/7B) exclusively on Exemplar2VQA-generated synthetic indoor data yields significant performance improvements across various diverse benchmarks. Furthermore, its effectiveness is not limited to in-domain indoor datasets but also robustly extends to outdoor and mixed-scene benchmarks. These results establish Exemplar2VQA as a scalable and powerful paradigm for bridging the sim-to-real gap in Embodied AI.},
  booktitle = {Advances in Neural Information Processing Systems},
  year = {2026},
  arxiv = {2609.37655},
  code = {https://github.com/yingjiayu12/Exemplar2VQA},
  preview = {exemplar2vqa.png},
  bibtex_show = {true},
  additional_info = {&nbsp;· **Accepted · [CCF-A](https://www.ccf.org.cn/Academic_Evaluation/AI/)**},
  note = {Generates scalable spatial question-answer data in simulated environments through exemplar-driven multi-agent coding, supporting spatial reasoning in vision-language models.},
  selected = {true}
}

@article{xu2026muse,
  abbr = {arXiv},
  title = {MUSE: Agentic 3D Scene Authoring via Memory-Grounded Incremental Requirement Satisfaction},
  author = {Xu, Ruijie and Zhu, Xinnan and Ying, Jiayu and Dong, Daoguo and Ji, Yuzhou and Tan, Xin},
  abstract = {Text-driven 3D scene generation is promising for digital content creation, embodied AI simulation, and interactive design, yet practical workflows require refining existing scenes while preserving non-target content. MUSE formulates controllable 3D scene authoring as incremental requirement satisfaction and introduces a memory-grounded multi-agent framework with an Architect, Sculptor, and Inspector. It also introduces AuthorBench for requirement-level controllability and preservation-aware editing.},
  journal = {arXiv preprint arXiv:2606.14168},
  year = {2026},
  arxiv = {2606.14168},
  website = {https://xujay111.github.io/muse_githubio/},
  preview = {muse.png},
  bibtex_show = {true},
  additional_info = {&nbsp;· Ruijie Xu and Xinnan Zhu contributed equally},
  note = {Enables controllable 3D scene authoring through memory-grounded multi-agent collaboration, satisfying new requirements while preserving existing scene content. Includes AuthorBench for evaluating controllability and preservation.},
  selected = {true}
}

@article{zhu2026jointedit3d,
  abbr = {arXiv},
  title = {JointEdit3D: Feed-Forward 3D Scene Editing in a Unified Latent Space},
  author = {Zhu, Xinnan and Xu, Ruijie and Ying, Jiayu and Dong, Daoguo and Xu, Jiachen and Xie, Yuan and Tan, Xin},
  abstract = {JointEdit3D performs feed-forward 3D scene editing in a unified RGB-geometry latent space. It uses asymmetric latent inpainting and a SceneAnchor Branch to propagate an edit from one reference frame while preserving source-scene structure. The work also introduces the SceneEdit3D-15K paired dataset and the SceneEdit3D-Bench evaluation benchmark.},
  journal = {arXiv preprint arXiv:2606.13345},
  year = {2026},
  arxiv = {2606.13345},
  website = {https://xinnan-zhu.github.io/JointEdit3D-Page/},
  code = {https://github.com/xinnan-zhu/JointEdit3D},
  preview = {jointedit3d.png},
  bibtex_show = {true},
  additional_info = {&nbsp;· Xinnan Zhu and Ruijie Xu contributed equally},
  note = {Edits 3D scenes in a unified RGB-geometry latent space, with SceneEdit3D-15K paired data and SceneEdit3D-Bench for evaluation. The repository hosts project and dataset information; implementation release is pending.},
  selected = {true}
}

@article{yu2026tsha,
  abbr = {arXiv},
  title = {TSHA: A Benchmark for Visual Language Models in Trustworthy Safety Hazard Assessment Scenarios},
  author = {Yu, Qiucheng and Xu, Ruijie and Chen, Mingang and Dong, Jianfeng and Tan, Xin},
  abstract = {TSHA is a benchmark for trustworthy indoor safety hazard assessment with vision-language models. Its current release contains 66,668 validated question-answer pairs across images, videos, and panoramas, covering 12 parent hazard groups and 64 fine-grained hazard types. Evaluation of 22 popular VLMs shows that current models still lack robust safety hazard assessment capabilities.},
  journal = {arXiv preprint arXiv:2603.29759},
  year = {2026},
  arxiv = {2603.29759},
  preview = {tsha.png},
  bibtex_show = {true},
  note = {Benchmarks vision-language models on indoor safety hazard assessment using image, video, and panoramic question-answer data, covering 12 hazard groups and 64 fine-grained hazard types.},
  selected = {true}
}

@article{xu2025oshsplat,
  abbr = {Vis. Comput.},
  title = {OSH-Splat: Optimizable Semantic Hyperplanes for Enhanced 3D Language Feature Gaussian Splatting},
  author = {Xu, Ruijie and Ji, Yuzhou and Tan, Xin and Ma, Lizhuang},
  abstract = {OSH-Splat constructs a compact 3D language field for accurate and efficient open-vocabulary queries. It extracts hierarchical semantic information at part, subpart, and whole levels, learns compact semantic features on 3D Gaussians, and optimizes a semantic hyperplane for each text query to improve localization accuracy and robustness.},
  journal = {The Visual Computer},
  volume = {41},
  number = {13},
  pages = {11127--11137},
  year = {2025},
  doi = {10.1007/s00371-025-04091-5},
  preview = {oshsplat.png},
  bibtex_show = {true},
  additional_info = {&nbsp;· **Published · [CCF-C](https://www.ccf.org.cn/Academic_Evaluation/CGAndMT/)**},
  note = {Builds compact 3D language fields for open-vocabulary scene understanding through semantic feature learning and query-specific hyperplane optimization.},
  selected = {true}
}
